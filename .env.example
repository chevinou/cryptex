# ============================================================
#  CRYPTEX — Variables d'environnement
#  Copiez ce fichier en .env et adaptez les valeurs.
#  Le fichier .env ne doit JAMAIS être commité sur Git.
# ============================================================

# ── Port d'écoute de l'application ──────────────────────────
APP_PORT=8080

# ── Nom et URL de l'application ─────────────────────────────
APP_NAME=Cryptex
APP_URL=http://localhost:8080
# En production :
# APP_URL=https://cryptex.exemple.fr

# ── Modules d'authentification ───────────────────────────────
# Activez au moins un module (true/false)

AUTH_SSO=true       # SSO / SAML (portail centralisé)
AUTH_LDAP=false     # Active Directory (login + mot de passe)
AUTH_LOCAL=false    # Comptes locaux Cryptex

# Mode affiché par défaut sur la page de connexion : sso | ldap | local
AUTH_DEFAULT=sso

# ── SSO ──────────────────────────────────────────────────────
SSO_URL=https://sso.exemple.fr/saml/index.php
SSO_LOGOUT=https://sso.exemple.fr/saml/logoutSSO.php

# ── LDAP / Active Directory ──────────────────────────────────
LDAP_HOST=ldap://ad.exemple.fr
LDAP_PORT=389
LDAP_BASE_DN=DC=exemple,DC=fr
LDAP_BIND_USER=CN=svc-cryptex,OU=Services,DC=exemple,DC=fr
LDAP_BIND_PASS=
LDAP_DOMAIN=exemple.fr
LDAP_SEARCH=true     # Autocomplétion destinataires via AD

# ── Clé de chiffrement AES-256 ───────────────────────────────
# ⚠️  OBLIGATOIRE — 32 caractères minimum, aléatoire et unique.
# Génération rapide : openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Base de données ──────────────────────────────────────────
# sqlite (recommandé pour petit déploiement)
# mysql  (recommandé en production, nécessite le profil mysql)
DB_DRIVER=sqlite

# MySQL / MariaDB (ignoré si DB_DRIVER=sqlite)
DB_ROOT_PASS=rootsecret_change_me
DB_NAME=cryptex
DB_USER=cryptex
DB_PASS=changeme_db

# ── Email ────────────────────────────────────────────────────
MAIL_HOST=smtp.exemple.fr
MAIL_PORT=25
MAIL_FROM=cryptex@exemple.fr
MAIL_FROM_NAME=Cryptex
MAIL_AUTH=false
MAIL_USER=
MAIL_PASS=

# ── PHPMyAdmin (profil debug uniquement) ─────────────────────
PMA_PORT=8081
